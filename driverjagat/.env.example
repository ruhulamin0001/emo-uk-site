# ─────────────────────────────────────────────────────────────
# DriverJagat - environment
#
# 1. Ei file ta `.env.local` name e copy korun
# 2. Firebase Console theke mullo gulo boshan
# 3. `.env.local` KOKHONO git e push korben na (.gitignore e ache)
# ─────────────────────────────────────────────────────────────

# ── Firebase - client (browser e dekha jay, eta thik ache) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-driverjagat.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-driverjagat
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-driverjagat.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin - SUDHU server, KOKHONO NEXT_PUBLIC_ na ──
# Console → Project settings → Service accounts → Generate new private key
FIREBASE_CLIENT_EMAIL=
# Purota quote er bhitore, newline `\n` hishebe:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ── Emulator ──
# `true` hole kono asol Firebase project lage na, service account o lage na.
# Local e kaj korar somoy SOB SOMOY true rakhben.
# PRODUCTION E SOB SOMOY false - true mane sobai malik, login chara.
NEXT_PUBLIC_USE_EMULATOR=true

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sudhu PRODUCTION e `true`. Staging e true dile Google staging ta
# index kore felbe, ar duita site ek i lekha niye lorbe.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Payment - AmaderPay ──
# Ei gulo na thakle app ta nijei "bikash e pathan" mode e chole
# jay - kichhu bhange na.
#
# Merchant Portal → "API Keys & Phone App" → Copy Key
AMADERPAY_API_KEY=
# Prayojon hole bodlano jabe. Na dile niche r ta i dhora hoy.
AMADERPAY_BASE_URL=https://amaderpay.vercel.app
#
# Ei ta ALADA kore `true` korte hobe, ar SUDHU ekta ASOL
# taka pathiye purota kaj korte dekhar POR.
AMADERPAY_VERIFIED=false
#
# Portal → "Webhook & সেটিং" e ei URL ta boshate hobe:
#   https://driver.jagatitlimited.com/api/payments/callback
#
# Oichhik. Thakle webhook er HMAC soi mile dekha hoy - ekta
# sosta prothom chhakni. Na thakleo nirapotta kome na, karon
# amra emniteo nijera tader API te giye jachai kori.
AMADERPAY_WEBHOOK_SECRET=

# ── SMS ──
# Na dile SMS sudhu log e jay - kichhu BHANGE na. Ei ta
# icchakrito: SMS gateway bondho thakle jodi job approve o
# atke jeto, tahole ekta SMS company amader babsa bondho kore
# dite parto.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=

# ── Cloudflare proxy ──
# Cloudflare er komla megh (proxy) ON korle EI TA true korun.
#
# Kano: proxy on hole SOB request Cloudflare diye ashe, ar
# `x-forwarded-for` er sesh IP ta hoy Cloudflare er edge IP -
# asol manush er na. Tokhon rate limit SOB manush ke ek dhore
# block kore dey.
#
# `true` korle amra `cf-connecting-ip` porhi (Cloudflare NIJE
# bosay, asol manush er IP, spoof kora jay na).
#
# Duita jinish EK SHATHE bodlate hobe: Cloudflare dashboard e
# proxy ON, ar ei env `true`. Ekta korle onnota na korle rate
# limit bhenge jabe.
BEHIND_CLOUDFLARE=false

# ── Error tracking (pore) ──
SENTRY_DSN=
