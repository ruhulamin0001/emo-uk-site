{
  "name": "driverjagat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:emulator": "concurrently -n emu,next -c magenta,cyan \"npm:emulator\" \"next dev\"",
    "emulator": "firebase emulators:start --only auth,firestore,storage",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "check:style": "tsx scripts/check-style.ts",
    "check:security": "tsx scripts/check-security.ts",
    "check:public": "tsx --conditions=react-server scripts/check-public.ts",
    "check:config": "tsx --conditions=react-server scripts/check-config.ts",
    "check:rules": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/check-rules.ts",
    "make-owner": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/make-owner.ts",
    "e2e": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/e2e-smoke.ts",
    "verify": "npm run check:style && npm run check:security && npm run check:public && npm run check:config && npm run check:money && npm run check:multisite && npm run typecheck && npm run lint && npm run check:rules",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "check:money": "tsx --conditions=react-server scripts/check-money.ts",
    "check:multisite": "tsx --conditions=react-server scripts/check-multisite.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.34.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "firebase-tools": "^14.27.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
