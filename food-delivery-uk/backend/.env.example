# Copy to .env and fill in real values
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quickbite_uk
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed for CORS (admin panel dev server, etc.)
CORS_ORIGINS=http://localhost:5173
# Seed admin credentials (used by npm run db:seed)
SEED_ADMIN_EMAIL=admin@quickbite.uk
SEED_ADMIN_PASSWORD=ChangeMe123!
