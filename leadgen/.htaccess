# This directory is a private sales workspace, not part of the website.
# Hostinger runs Apache, so this blocks it from being served if the folder
# ever ends up inside the deployed web root.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
