# Public hostname of the PBX. A record -> VPS_IP. Fixed for this project:
DOMAIN=aiagent.jagatitlimited.com
VPN_SUBNET=10.8.0.0/24
# BD office static public IP (optional, lets office softphones reach SIP without VPN after T9)
OFFICE_IP=
OPENAI_API_KEY=CHANGE_ME
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
GEMINI_API_KEY=
SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_KEY=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID_BIZ1=CHANGE_ME
TELEGRAM_CHAT_ID_BIZ2=
TELEGRAM_CHAT_ID_BIZ3=
TELEGRAM_CHAT_ID_BIZ4=
TELEGRAM_CHAT_ID_BIZ5=
