# /opt/ai-bridge/.env  (chmod 600, owner asterisk)
# Loaded by systemd EnvironmentFile, which does NOT strip trailing "# comments".
# Keep every comment on its own line.

# realtime_openai | realtime_gemini | pipeline
AGENT_MODE=realtime_openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
SUMMARY_MODEL=gpt-5-mini
# pipeline mode only
PIPELINE_LLM=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
ASTERISK_RATE=8000
# frames the player may run ahead of real time (20 ms each). Lower = faster barge in.
PLAYBACK_LEAD_FRAMES=3

AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=aibridge
AMI_SECRET=CHANGE_ME

SUPABASE_URL=CHANGE_ME
SUPABASE_SERVICE_KEY=CHANGE_ME

TOOLS_ENABLED=transfer_to_human,request_callback,lookup_order

# telegram | whatsapp | telegram,whatsapp
NOTIFY=telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
OWNER_CHAT_IDS=biz1:CHANGE_ME,biz2:,biz3:,biz4:,biz5:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
OWNER_WHATSAPP=biz1:8801XXXXXXXXX

HUMAN_RING_GROUPS=biz1:601,biz2:602,biz3:603,biz4:604,biz5:605
MAX_CALL_SECONDS=600
PROMPT_DIR=/opt/ai-bridge/prompts
LOG_LEVEL=INFO
