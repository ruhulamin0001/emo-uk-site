# /root/bd-voice-stack/.env on the VPS. Never in git. docker compose reads it (env_file).
# No trailing "# comments" on value lines.

# ---- asterisk container ----
# public IP of this VPS (Hostinger srv1569293) and the name softphones will use
PUBLIC_IP=72.62.213.196
PBX_DOMAIN=aiagent.jagatitlimited.com
# RTP range published on the host. Keep it narrow, docker publishes one proxy per port.
RTP_START=10000
RTP_FINISH=10200
# optional: only these networks may register softphone extensions (BD office static IP, UK office).
# Empty = anywhere (strong random passwords + fail2ban still apply).
EXTENSION_ALLOW_CIDR=

# ---- ai-bridge ----
# realtime_gemini | realtime_openai | pipeline
AGENT_MODE=realtime_gemini
# key from a Bangladesh Google account (free tier is not offered to UK accounts)
GEMINI_API_KEY=CHANGE_ME
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
SUMMARY_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
# pipeline mode only. LLM is any OpenAI compatible endpoint. DeepSeek example:
#   PIPELINE_LLM_BASE_URL=https://api.deepseek.com  PIPELINE_LLM=deepseek-chat  PIPELINE_LLM_API_KEY=...
# Empty base url = OpenAI with OPENAI_API_KEY.
PIPELINE_LLM=gpt-5-mini
PIPELINE_LLM_BASE_URL=
PIPELINE_LLM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

AUDIOSOCKET_PORT=9092
ASTERISK_RATE=8000
PLAYBACK_LEAD_FRAMES=3

AMI_HOST=asterisk
AMI_PORT=5038
AMI_USER=aibridge
AMI_SECRET=CHANGE_ME

# Postgres container `db` (call log, callbacks, orders)
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://aibridge:CHANGE_ME@db:5432/aibridge

TOOLS_ENABLED=transfer_to_human,request_callback,lookup_order

# whatsapp | telegram | whatsapp,telegram
NOTIFY=whatsapp
WHATSAPP_TOKEN=CHANGE_ME
WHATSAPP_PHONE_ID=CHANGE_ME
OWNER_WHATSAPP=biz1:8801XXXXXXXXX,biz2:,biz3:,biz4:,biz5:
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_IDS=

HUMAN_RING_GROUPS=biz1:601,biz2:602,biz3:603,biz4:604,biz5:605
MAX_CALL_SECONDS=600
LOG_LEVEL=INFO
